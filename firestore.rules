rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validAccountType(value) {
      return value == "host" || value == "advertiser";
    }

    function ownsTenant(tenantId) {
      return signedIn()
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "owner"
        && request.resource.data.status == "active"
        && validAccountType(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          "uid","email","displayName","phone","tenantId","role",
          "accountType","status","createdAt","updatedAt"
        ]);

      allow read: if signedIn() && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.plan == "pilot"
        && validAccountType(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          "name","ownerUid","accountType","status","plan","createdAt","updatedAt"
        ]);

      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;

      match /points/{pointId} {
        allow create: if ownsTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid;

        allow read: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.tenantId == tenantId;

        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tenantId == resource.data.tenantId;

        allow delete: if false;
      }

      match /screens/{screenId} {
        allow create: if ownsTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.playerPath == "/player/" + screenId
          && request.resource.data.manifestVersion == 0
          && request.resource.data.playlistStatus == "empty";

        allow read: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.tenantId == tenantId;

        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.playerPath == resource.data.playerPath;

        allow delete: if false;
      }
      match /campaigns/{campaignId} {
        allow create: if ownsTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.mimeType == "video/mp4"
          && request.resource.data.sizeBytes <= 60 * 1024 * 1024;

        allow read: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.tenantId == tenantId;

        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.mediaPath == resource.data.mediaPath;

        allow delete: if false;
      }

      match /playlists/{screenId} {
        allow create: if ownsTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.screenId == screenId
          && request.resource.data.status == "published";

        allow read: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.tenantId == tenantId;

        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.screenId == resource.data.screenId;

        allow delete: if false;
      }

    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
