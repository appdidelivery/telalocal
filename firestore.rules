rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userTenantId() {
      return signedIn() ? userDoc().data.tenantId : null;
    }

    function belongsToTenant(tenantId) {
      return signedIn() && userTenantId() == tenantId;
    }

    function validAccountType(value) {
      return value == "host" || value == "advertiser";
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "owner"
        && request.resource.data.status == "active"
        && validAccountType(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "phone",
          "tenantId",
          "role",
          "accountType",
          "status",
          "createdAt",
          "updatedAt"
        ]);

      allow read: if signedIn() && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.plan == "pilot"
        && validAccountType(request.resource.data.accountType);

      allow read: if belongsToTenant(tenantId);

      allow update: if belongsToTenant(tenantId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;

      match /{document=**} {
        allow read: if belongsToTenant(tenantId);

        allow create: if belongsToTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if belongsToTenant(tenantId)
          && resource.data.tenantId == tenantId
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.ownerUid == resource.data.ownerUid;

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
