rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userTenantId() {
      return signedIn() ? userDoc().data.tenantId : null;
    }

    function belongsToTenant(tenantId) {
      return signedIn() && userTenantId() == tenantId;
    }

    function validAccountType(value) {
      return value == "host" || value == "advertiser";
    }

    function screenDoc(tenantId, screenId) {
      return get(
        /databases/$(database)/documents/tenants/$(tenantId)/screens/$(screenId)
      );
    }

    function conversionLink(token) {
      return get(
        /databases/$(database)/documents/conversionLinks/$(token)
      );
    }

    function validProofBatch(tenantId, batchId) {
      return request.resource.data.keys().hasOnly([
          "tenantId",
          "screenId",
          "playerKey",
          "batchId",
          "date",
          "totalPlays",
          "campaignCounts",
          "manifestVersion",
          "firstPlayedAt",
          "lastPlayedAt",
          "batchCreatedAt"
        ])
        && request.resource.data.tenantId == tenantId
        && request.resource.data.batchId == batchId
        && request.resource.data.totalPlays > 0
        && request.resource.data.screenId is string
        && request.resource.data.playerKey is string
        && screenDoc(tenantId, request.resource.data.screenId).data.playerKey
          == request.resource.data.playerKey
        && screenDoc(tenantId, request.resource.data.screenId).data.status
          == "active";
    }

    function validConversionEvent(tenantId) {
      let link = conversionLink(request.resource.data.token);

      return request.resource.data.keys().hasOnly([
          "tenantId",
          "token",
          "screenId",
          "campaignId",
          "eventType",
          "date",
          "eventAt"
        ])
        && request.resource.data.tenantId == tenantId
        && request.resource.data.eventType in [
          "qr_scan",
          "whatsapp_click",
          "coupon_copy"
        ]
        && link.data.status == "active"
        && link.data.tenantId == tenantId
        && link.data.screenId == request.resource.data.screenId
        && link.data.campaignId == request.resource.data.campaignId;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "owner"
        && request.resource.data.status == "active"
        && validAccountType(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "phone",
          "tenantId",
          "role",
          "accountType",
          "status",
          "createdAt",
          "updatedAt"
        ]);

      allow read: if signedIn() && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.plan == "pilot"
        && validAccountType(request.resource.data.accountType);

      allow read: if belongsToTenant(tenantId);

      allow update: if belongsToTenant(tenantId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;

      match /proofBatches/{batchId} {
        allow create: if validProofBatch(tenantId, batchId);

        allow update: if validProofBatch(tenantId, batchId)
          && request.resource.data == resource.data;

        allow delete: if false;
      }

      match /conversionEvents/{eventId} {
        allow create: if validConversionEvent(tenantId);
        allow read: if belongsToTenant(tenantId);
        allow update, delete: if false;
      }

      match /heartbeats/{screenId} {
        allow read: if belongsToTenant(tenantId);

        allow create, update: if request.resource.data.keys().hasOnly([
            "tenantId",
            "screenId",
            "playerKey",
            "playerState",
            "currentCampaignId",
            "currentCampaignName",
            "manifestVersion",
            "mediaCount",
            "lastSeenAtMs",
            "online",
            "userAgent",
            "viewport",
            "appVersion"
          ])
          && request.resource.data.tenantId == tenantId
          && request.resource.data.screenId == screenId
          && request.resource.data.playerKey is string
          && request.resource.data.playerState in [
            "active",
            "paused",
            "waiting"
          ]
          && request.resource.data.lastSeenAtMs is int
          && screenDoc(tenantId, screenId).data.playerKey
            == request.resource.data.playerKey;

        allow delete: if false;
      }

      match /{document=**} {
        allow read: if belongsToTenant(tenantId);

        allow create: if belongsToTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if belongsToTenant(tenantId)
          && resource.data.tenantId == tenantId
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.ownerUid == resource.data.ownerUid;

        allow delete: if false;
      }
    }

    match /pairRequests/{pairId} {
      allow create: if request.resource.data.keys().hasOnly([
          "pairId",
          "code",
          "status",
          "createdAtMs",
          "expiresAtMs"
        ])
        && request.resource.data.pairId == pairId
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.status == "pending"
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.resource.data.createdAtMs
        && request.resource.data.expiresAtMs
          <= request.resource.data.createdAtMs + 600000;

      allow get: if true;
      allow list: if signedIn();

      allow update: if signedIn()
        && resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "pairId",
          "code",
          "status",
          "createdAtMs",
          "expiresAtMs",
          "tenantId",
          "ownerUid",
          "screenId",
          "playerKey",
          "pairingEpoch",
          "pairedAtMs"
        ])
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.expiresAtMs == resource.data.expiresAtMs
        && request.resource.data.status == "paired"
        && request.resource.data.tenantId == userTenantId()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.pairedAtMs is int
        && request.resource.data.screenId is string
        && request.resource.data.playerKey is string
        && request.resource.data.pairingEpoch is int
        && screenDoc(
          userTenantId(),
          request.resource.data.screenId
        ).data.ownerUid == request.auth.uid
        && screenDoc(
          userTenantId(),
          request.resource.data.screenId
        ).data.playerKey == request.resource.data.playerKey
        && screenDoc(
          userTenantId(),
          request.resource.data.screenId
        ).data.pairingEpoch == request.resource.data.pairingEpoch
        && screenDoc(
          userTenantId(),
          request.resource.data.screenId
        ).data.status == "active";

      allow delete: if false;
    }

    match /screenAliases/{shortCode} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && belongsToTenant(request.resource.data.tenantId);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.tenantId == resource.data.tenantId
        && belongsToTenant(resource.data.tenantId);

      allow delete: if false;
    }

    match /conversionLinks/{token} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.token == token
        && belongsToTenant(request.resource.data.tenantId);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.token == resource.data.token
        && belongsToTenant(resource.data.tenantId);

      allow delete: if false;
    }

    match /networkInventory/{screenId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.screenId == screenId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.tenantId == userTenantId();

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.screenId == resource.data.screenId;

      allow delete: if false;
    }

    match /playerManifests/{screenId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.screenId == screenId
        && request.resource.data.status == "published"
        && request.resource.data.schemaVersion == 1
        && belongsToTenant(request.resource.data.tenantId);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.screenId == resource.data.screenId
        && request.resource.data.status == "published"
        && request.resource.data.schemaVersion == 1
        && belongsToTenant(resource.data.tenantId);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
